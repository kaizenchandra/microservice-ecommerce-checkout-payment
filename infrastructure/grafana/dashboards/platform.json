{
  "uid": "checkout-platform",
  "title": "Checkout Platform",
  "schemaVersion": 40,
  "version": 3,
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Application availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"applications\"}",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "JVM heap used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP server error rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Business throughput",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (rate(orders_created_total[5m]))",
          "legendFormat": "{{application}} Orders created"
        },
        {
          "refId": "B",
          "expr": "sum by (application) (rate(inventory_reservations_accepted_total[5m]))",
          "legendFormat": "{{application}} Reservations accepted"
        },
        {
          "refId": "C",
          "expr": "sum by (application) (rate(payments_accepted_total[5m]))",
          "legendFormat": "{{application}} Payments accepted"
        }
      ]
    },
    {
      "id": 6,
      "title": "Payment outcomes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (rate(payments_completed_total[5m]))",
          "legendFormat": "{{application}} Completed"
        },
        {
          "refId": "B",
          "expr": "sum by (application) (rate(payments_declined_total[5m]))",
          "legendFormat": "{{application}} Declined"
        },
        {
          "refId": "C",
          "expr": "sum by (application) (rate(payments_recovery_deferred_total[5m]))",
          "legendFormat": "{{application}} Recovery deferred"
        }
      ]
    },
    {
      "id": 7,
      "title": "Listener attempts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application, outcome) (rate(messaging_processed_total[5m]))",
          "legendFormat": "{{application}} {{outcome}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Dead-letter recovery",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (rate(consumer_dlt_published_total[5m]))",
          "legendFormat": "{{application}} Published"
        },
        {
          "refId": "B",
          "expr": "sum by (application) (rate(consumer_dlt_failures_total[5m]))",
          "legendFormat": "{{application}} Failed"
        }
      ]
    }
  ]
}
